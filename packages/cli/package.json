{
  "name": "kalup",
  "version": "0.2.0",
  "description": "Configuration as code for HubSpot: pull, compare, plan and apply properties and property groups",
  "keywords": [
    "hubspot",
    "crm",
    "configuration-as-code",
    "infrastructure-as-code",
    "iac",
    "cli",
    "typescript",
    "schema",
    "devops"
  ],
  "homepage": "https://kalup.dev",
  "bugs": {
    "url": "https://github.com/scopiousdigital/kalup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scopiousdigital/kalup.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "author": "Scopious (https://scopious.dev)",
  "type": "module",
  "exports": {
    "./schemas/*.json": "./dist/schemas/*.json"
  },
  "bin": {
    "kalup": "./bin/kalup.mjs"
  },
  "files": [
    "bin",
    "dist",
    "!dist/build-stamp.json",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "test -f dist/index.mjs && cp ../../LICENSE ../../NOTICE .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "oclif": {
    "bin": "kalup",
    "commands": {
      "identifier": "COMMANDS",
      "strategy": "explicit",
      "target": "./dist/commands.mjs"
    },
    "description": "Kalup: configuration as code for HubSpot.",
    "dirname": "kalup",
    "topicSeparator": " ",
    "topics": {
      "blueprint": {
        "description": "Upgrade a blueprint added with kalup add."
      },
      "state": {
        "description": "Inspect and rebuild the state file of a target's portal."
      },
      "target": {
        "description": "Change a target's portal."
      }
    }
  },
  "dependencies": {
    "@kalup/core": "workspace:*",
    "@oclif/core": "^5.1.2"
  },
  "devDependencies": {
    "@kalup/engine": "workspace:*",
    "@kalup/tsconfig": "workspace:*",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.13.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
