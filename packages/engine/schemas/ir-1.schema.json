{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalup.dev/schemas/ir-1.schema.json",
  "title": "Kalup IR, version 1",
  "description": "What a Kalup project's config files mean, derived by `kalup ir`, or what a portal holds, captured by `kalup snapshot` with an observation block. Open for additions within ir/1 (docs/compatibility.md): the document, each resource and everything below it accept fields this schema does not list, and readers keep or ignore them; a later 1.x may add a resource type, and a reader reports an address of a type it does not handle as unknown. Closed, because a new value changes what a reader may conclude: generator, a $ref, a tombstone, the read statuses in coverage, lifecycle.options, and a target's drift and adopt.",
  "type": "object",
  "required": ["irVersion", "project", "generator", "resources", "targets", "tombstones"],
  "properties": {
    "irVersion": {
      "const": 1
    },
    "project": {
      "type": "string"
    },
    "generator": {
      "type": "object",
      "required": ["name", "version", "frontend"],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "frontend": {
          "enum": ["ts", "portal"]
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "patternProperties": {
        "^[a-z]+:\\S+$": {
          "$ref": "#/$defs/resource"
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/target"
      }
    },
    "tombstones": {
      "type": "object",
      "patternProperties": {
        "^[a-z]+:\\S+$": {
          "$ref": "#/$defs/tombstone"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "$ref": "#/$defs/observation"
    },
    "x": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["generator"],
        "properties": {
          "generator": {
            "required": ["frontend"],
            "properties": {
              "frontend": {
                "const": "portal"
              }
            }
          }
        }
      },
      "then": {
        "required": ["observation"]
      }
    }
  ],
  "$defs": {
    "address": {
      "description": "'<type>:<path>', for example property:companies/billing_status.",
      "type": "string",
      "pattern": "^[a-z]+:\\S+$"
    },
    "ref": {
      "description": "A logical reference, allowed anywhere inside a definition where HubSpot wants an ID.",
      "type": "object",
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "$ref": "#/$defs/address"
        }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["type", "managed"],
      "properties": {
        "type": {
          "type": "string"
        },
        "managed": {
          "type": "boolean"
        },
        "definition": {
          "type": "object"
        },
        "lookup": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "x": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["managed"],
            "properties": {
              "managed": {
                "const": true
              }
            }
          },
          "then": {
            "required": ["definition"]
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {
                "const": "property"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "$ref": "#/$defs/propertyFields"
              }
            }
          }
        },
        {
          "if": {
            "required": ["type", "managed"],
            "properties": {
              "type": {
                "const": "property"
              },
              "managed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "required": ["label", "group", "type", "fieldType"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {
                "const": "group"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "$ref": "#/$defs/groupDefinition"
              }
            }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "$ref": "#/$defs/objectDefinition"
              }
            }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {
                "const": "pipeline"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "$ref": "#/$defs/pipelineDefinition"
              }
            }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {
                "const": "stage"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "$ref": "#/$defs/stageDefinition"
              }
            }
          }
        },
        {
          "if": {
            "required": ["type"],
            "properties": {
              "type": {
                "const": "association"
              }
            }
          },
          "then": {
            "properties": {
              "definition": {
                "$ref": "#/$defs/associationDefinition"
              }
            }
          }
        }
      ]
    },
    "propertyFields": {
      "description": "A property definition in HubSpot terms. A managed property needs label, group, type and fieldType; an unmanaged one may carry any subset, such as the options of a HubSpot-defined enumeration.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/ref"
        },
        "type": {
          "type": "string",
          "description": "A value HubSpot defines; known values: string, number, bool, date, datetime, enumeration, phone_number. A later version may record one HubSpot adds."
        },
        "fieldType": {
          "type": "string",
          "description": "A value HubSpot defines; known values: text, textarea, file, phonenumber, number, booleancheckbox, select, radio, checkbox, date, html, calculation_equation. A later version may record one HubSpot adds."
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "hasUniqueValue": {
          "type": "boolean"
        },
        "formField": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "displayOrder": {
          "type": "integer",
          "minimum": -1
        },
        "numberDisplayHint": {
          "type": "string",
          "description": "A value HubSpot defines; known values: currency, duration, formatted, percentage, probability, unformatted. A later version may record one HubSpot adds."
        },
        "showCurrencySymbol": {
          "type": "boolean"
        },
        "currencyPropertyName": {
          "type": "string"
        },
        "textDisplayHint": {
          "type": "string",
          "description": "A value HubSpot defines; known values: domain_name, email, ip_address, multi_line, phone_number, physical_address, postal_code, unformatted_single_line. A later version may record one HubSpot adds."
        },
        "calculationFormula": {
          "type": "string"
        },
        "dataSensitivity": {
          "type": "string",
          "description": "A value HubSpot defines; known values: non_sensitive, sensitive, highly_sensitive. A later version may record one HubSpot adds."
        },
        "externalOptions": {
          "const": true
        },
        "referencedObjectType": {
          "const": "OWNER"
        }
      },
      "additionalProperties": true
    },
    "option": {
      "description": "One enumeration option. Array index is display order. The app alias lives in binding.aliases, never here.",
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "patternProperties": {
        "^as$": false
      }
    },
    "groupDefinition": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "objectDefinition": {
      "description": "A custom object schema. Its properties and groups are resources of their own.",
      "type": "object",
      "required": ["labels"],
      "properties": {
        "labels": {
          "type": "object",
          "required": ["singular", "plural"],
          "properties": {
            "singular": {
              "type": "string"
            },
            "plural": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "description": {
          "type": "string"
        },
        "primaryDisplayProperty": {
          "type": "string"
        },
        "requiredProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "searchableProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secondaryDisplayProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "pipelineDefinition": {
      "description": "A pipeline. Its stages are resources of their own; stages lists their IDs in display order.",
      "type": "object",
      "required": ["label", "displayOrder", "stages"],
      "properties": {
        "label": {
          "type": "string"
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 0
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "stageDefinition": {
      "description": "A pipeline stage. Its metadata field depends on the object: probability on deals, ticketState on tickets, state on custom objects.",
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ticketState": {
          "type": "string",
          "description": "A value HubSpot defines; known values: OPEN, CLOSED. A later version may record one HubSpot adds."
        },
        "state": {
          "type": "string",
          "description": "A value HubSpot defines; known values: OPEN, CLOSED. A later version may record one HubSpot adds."
        }
      },
      "additionalProperties": true
    },
    "associationDefinition": {
      "description": "An association label between two objects: label as the from object shows it, inverseLabel as the to object does. With neither, the plain association of a pair that has no HubSpot-defined one.",
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "inverseLabel": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "binding": {
      "description": "App terms, filled in by the loader. key and codec for properties, export for objects.",
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "codec": {
          "type": "string",
          "pattern": "^[a-zA-Z]+$",
          "description": "The builder. Known: string, number, boolean, date, datetime, enum, multiEnum, stringArray, json, phoneNumber, owner. A later version may add a builder."
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "strict": {
          "type": "boolean"
        },
        "export": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "required": ["options"],
      "properties": {
        "options": {
          "enum": ["additive", "exact"]
        },
        "removedOptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignoreChanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preventDestroy": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "description": "Merged from blueprints.lock.json in the folder of object files by the loader. Absent means authored by hand.",
      "type": "object",
      "required": ["blueprint", "version", "sourceAddress", "prefix", "hash"],
      "properties": {
        "blueprint": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sourceAddress": {
          "$ref": "#/$defs/address"
        },
        "prefix": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "target": {
      "description": "One named portal. Credentials never enter the IR.",
      "type": "object",
      "required": ["portalId"],
      "properties": {
        "portalId": {
          "type": "integer",
          "minimum": 1
        },
        "protected": {
          "type": "boolean"
        },
        "drift": {
          "enum": ["hold", "overwrite"]
        },
        "adopt": {
          "description": "What a plan does with a unit that has no base and differs. Default hold.",
          "enum": ["hold", "overwrite"]
        },
        "allowDestroy": {
          "description": "Whether a destroy tombstone or a takeover removal may delete in this portal. Default false.",
          "type": "boolean"
        },
        "yesLimit": {
          "description": "The most writes, adoptions and releases one --yes covers; 0 turns --yes off. Default 25.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "overrides": {
          "type": "object",
          "patternProperties": {
            "^[a-z]+:\\S+$": {
              "$ref": "#/$defs/override"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true,
      "patternProperties": {
        "^credentials$": false
      }
    },
    "override": {
      "type": "object",
      "properties": {
        "skip": {
          "const": true
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "object"
        },
        "lookup": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "observation": {
      "description": "What a snapshot read: the target, when, and how completely. A portal-frontend document requires it. observedAt is the one timestamp an ir/1 document carries.",
      "type": "object",
      "required": ["target", "observedAt", "coverage"],
      "properties": {
        "target": {
          "type": "object",
          "required": ["name", "portalId"],
          "properties": {
            "name": {
              "type": "string"
            },
            "portalId": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "observedAt": {
          "description": "ISO 8601 in UTC, as Date.prototype.toISOString writes it.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "description": "What the read covered. Only a complete read proves that a resource is absent.",
      "type": "object",
      "required": ["complete", "objects", "otherObjects", "notCaptured"],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "objects": {
          "description": "One entry per config object key.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/objectCoverage"
          }
        },
        "otherObjects": {
          "description": "Custom objects in the portal that config does not name, or unknown when the schemas list was not read.",
          "type": ["array", "string"],
          "items": {
            "type": "string"
          },
          "if": {
            "type": "string"
          },
          "then": {
            "const": "unknown"
          }
        },
        "settling": {
          "description": "Resources the read cannot be trusted on yet, by address: apply wrote them minutes ago and HubSpot still serves an older copy (stale), or does not list one Kalup created (missing). Unknown until the time given, never absent or drifted.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["reason", "until"],
            "properties": {
              "reason": {
                "type": "string",
                "description": "Why it settles. Known: stale, missing. A later version may add a reason."
              },
              "until": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "notCaptured": {
          "description": "Documented response fields Kalup drops, by resource type. A later version may add a type.",
          "type": "object",
          "required": ["property", "group", "object"],
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]+$": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "objectCoverage": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["read", "unreadable", "absent", "excluded"]
        },
        "missingScope": {
          "description": "Unreadable only.",
          "type": "string"
        },
        "issue": {
          "description": "Unreadable only.",
          "type": "string"
        },
        "objectTypeId": {
          "description": "A custom object that exists.",
          "type": "string"
        },
        "outOfScope": {
          "description": "Present properties outside the pull scope that config does not name.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shadowed": {
          "description": "Portal names equal to the local name of a renamed address, so not reported at it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unaddressable": {
          "description": "Present properties config names that are in a group whose name no address can hold, so not captured. What they hold is unknown.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unsupportedProperty"
          }
        },
        "unsupportedSchema": {
          "description": "A custom object HubSpot returned without a singular or plural label, its fields as returned. It is present but not a resource.",
          "type": "object",
          "required": ["labels"],
          "properties": {
            "labels": {
              "type": "object",
              "properties": {
                "singular": {
                  "type": "string"
                },
                "plural": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "description": {
              "type": "string"
            },
            "primaryDisplayProperty": {
              "type": "string"
            },
            "requiredProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "searchableProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "secondaryDisplayProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "excluded": {
          "description": "Addresses a skip override leaves out.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "renamed": {
          "description": "Addresses a name override points at another portal name.",
          "type": "object",
          "patternProperties": {
            "^[a-z]+:\\S+$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "pipelines": {
          "description": "Whether the object's pipelines list was read. Absent when its pipelines are not in scope.",
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "enum": ["read", "unreadable"]
            },
            "missingScope": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "associations": {
          "description": "The associations of the pairs this object is in, pair by pair: per other object, whether the pair was read, and the user-defined types of this direction no name reached; and the HubSpot type IDs of each association addressed from this object. Absent when no pair with this object is in scope.",
          "type": "object",
          "required": ["with"],
          "properties": {
            "with": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/pairCoverage"
              }
            },
            "typeIds": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "unsupportedProperty": {
      "description": "A present property Kalup does not write: no builder carries its type or fieldType, or HubSpot fills its options (owner or externalOptions). It is compared like any property but is not a resource.",
      "type": "object",
      "required": ["name", "type", "fieldType", "label", "group", "hubspotDefined"],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "fieldType": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/ref"
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "hubspotDefined": {
          "type": "boolean"
        },
        "externalOptions": {
          "type": "boolean"
        },
        "referencedObjectType": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "tombstone": {
      "description": "Written by `kalup rm`. destroy archives or deletes in the portal; release stops managing and leaves it.",
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "enum": ["destroy", "release"]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "pairCoverage": {
      "description": "One pair read with an object, from that object's side.",
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["read", "unreadable"]
        },
        "missingScope": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "unnamed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["typeId"],
            "properties": {
              "typeId": {
                "type": "integer"
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  }
}
