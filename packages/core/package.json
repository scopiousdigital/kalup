{
  "name": "@kalup/core",
  "version": "0.0.0",
  "description": "Kalup runtime: typed HubSpot property codecs, inference, config grammar and IR",
  "license": "Apache-2.0",
  "author": "Scopious (https://scopious.dev)",
  "homepage": "https://kalup.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scopiousdigital/kalup.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/scopiousdigital/kalup/issues"
  },
  "keywords": [
    "hubspot",
    "crm",
    "configuration-as-code",
    "infrastructure-as-code",
    "iac",
    "typescript",
    "schema",
    "devops"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@kalup/tsconfig": "workspace:*",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.1"
  }
}
