{
  "name": "@kalup/core",
  "version": "0.6.0",
  "description": "Kalup runtime: typed HubSpot property codecs, inference and the config file types",
  "keywords": [
    "hubspot",
    "crm",
    "configuration-as-code",
    "infrastructure-as-code",
    "iac",
    "typescript",
    "schema",
    "devops"
  ],
  "homepage": "https://kalup.dev",
  "bugs": {
    "url": "https://github.com/scopiousdigital/kalup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scopiousdigital/kalup.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Scopious (https://scopious.dev)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "!dist/build-stamp.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "test -f dist/index.mjs && cp ../../LICENSE ../../NOTICE .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@kalup/tsconfig": "workspace:*",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
