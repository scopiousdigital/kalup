{
  "name": "@kalup/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "deploy": "rm -rf .vinext/fonts && npx @vinext/cloudflare deploy",
